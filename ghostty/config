# This is the configuration file for Ghostty.
font-size = 12

# Background transparency (1 = opaque, 0 = fully transparent).
# Requires a compositor on Linux (e.g. Picom, Mutter, KWin) for the desktop to show through.
background-opacity = 0.92
# custom-shader = mirror.glsl
custom-shader = cursor_smear.glsl
custom-shader-animation = always
# The cursor_smear shader only animates a block cursor
cursor-style = block
cursor-color = white


